# Copy this file to `.env` and fill in the values you need. `.env` is gitignored.
# Every value below is a placeholder. Never commit a real key or any personal data.
#
# Precedence (highest first): real environment variables > `.env` > config/settings.yaml.
# Only the variables you actually set override anything; an empty value counts as "not set".

# OpenAI API key used by the Understand step (one call per request, photo and/or text).
# Required for real searches. Not needed for tests or for the fixture-mode UI.
OPENAI_API_KEY=sk-your-key-here

# Pinned OpenAI model: a dated snapshot ("...-YYYY-MM-DD" from OpenAI's model docs) or
# `gpt-6-luna`, the project's model, which OpenAI publishes only under that name.
# Aliases such as "...-latest" are rejected on purpose (the model must not change under us).
# Overrides `openai_model` in config/settings.yaml. Leave empty to use the value pinned there.
OPENAI_MODEL=

# User-Agent sent to store sites. Keep it honest and identifying; never imitate a browser.
VGA_USER_AGENT=vga-shopping-agent-demo/0.1 (store search demo)

# Image similarity backend. The default, set in config/settings.yaml, is `siglip` (local
# Marqo-FashionSigLIP). Uncomment this line and set `off` to disable image ranking. `siglip` needs
# the optional `ml` dependency group (`uv sync --group ml`) and the downloaded weights, and falls
# back to `off` with a warning when they are missing. Left commented out so that copying this file
# to `.env` does not override the YAML default.
# VGA_IMAGE_RANKER=off

# Directory for JSON-lines logs (gitignored). Logs never contain secrets or image data.
VGA_LOG_DIR=logs

# Log verbosity: DEBUG, INFO, WARNING or ERROR.
VGA_LOG_LEVEL=INFO

# Set to 1 to also log the text prompt and the parsed Understand result (never the photo).
VGA_LOG_PROMPTS=0

# Set to 1 to write each request's ranked candidates (URL, store, scores, range) to a JSONL file in
# VGA_LOG_DIR for debugging. No image data is written.
VGA_DEBUG_DUMP=0

# Path to the settings file. Leave empty to use config/settings.yaml.
VGA_SETTINGS_PATH=

# Daily cap on OpenAI calls. When reached, the app makes no further calls and says so plainly.
VGA_DAILY_LLM_CALL_CAP=200

# Set to 1 to run the Streamlit UI from the bundled sample response, with no backend and no network.
VGA_UI_FIXTURE=0
